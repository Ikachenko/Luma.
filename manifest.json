{
    "name": "Luma.",
    "description": "Simple, clean, and functional chrome homepage extension.",
    "version": "1.0",
    "manifest_version": 3,
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": "icon.png"
    },
    "chrome_url_overrides": {
        "newtab": "homepage/home.html"
    },
    "permissions": [
        "storage",
        "notifications"
    ],
   "background": {
      "service_worker": "service-worker.js",
      "type": "module"
    }
}